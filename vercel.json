{
    "services": {
        "frontend": {
            "root": "frontend/",
            "bindings": [
                {
                    "type": "service",
                    "service": "backend",
                    "format": "url",
                    "env": "BACKEND_URL"
                }
            ]
        },
        "backend": {
            "root": "backend/",
            "entrypoint": "app.main:app"
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": { "service": "backend" } },
        { "source": "/(.*)", "destination": { "service": "frontend" } }
    ]
}
